+/// Minimum number of RPC slots in an RDMA transport slot table.
+pub const RPCRDMA_MIN_SLOT_TABLE: u32 = 4;
+/// Default number of RPC slots in an RDMA transport slot table.
+pub const RPCRDMA_DEF_SLOT_TABLE: u32 = 128;
+/// Maximum number of RPC slots in an RDMA transport slot table.
+pub const RPCRDMA_MAX_SLOT_TABLE: u32 = 16_384;
+
+/// Minimum inline threshold, in bytes.
+pub const RPCRDMA_MIN_INLINE: i32 = 1_024;
+/// Default inline threshold, in bytes.
+pub const RPCRDMA_DEF_INLINE: i32 = 4_096;
+/// Maximum inline threshold, in bytes.
+pub const RPCRDMA_MAX_INLINE: i32 = 65_536;
+
+/// Memory registration strategy identifiers shared by kernel and user space.
+#[repr(C)]
+#[derive(Copy, Clone, Debug, Eq, PartialEq)]
+pub enum rpcrdma_memreg {
+    RPCRDMA_BOUNCEBUFFERS = 0,
+    RPCRDMA_REGISTER = 1,
+    RPCRDMA_MEMWINDOWS = 2,
+    RPCRDMA_MEMWINDOWS_ASYNC = 3,
+    RPCRDMA_MTHCAFMR = 4,
+    RPCRDMA_FRWR = 5,
+    RPCRDMA_ALLPHYSICAL = 6,
+    RPCRDMA_LAST = 7,
+}
