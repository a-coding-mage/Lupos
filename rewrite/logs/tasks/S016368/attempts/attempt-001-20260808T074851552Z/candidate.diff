+// SPDX-License-Identifier: GPL-2.0 WITH Linux-syscall-note
+//! linux-source: include/uapi/linux/securebits.h
+//! linux-revision: 425f94c2954b1fe80ebdbf9b29854e89750355df
+//! architectures: common
+//! rewrite-task: S016368
+
+pub const fn issecure_mask(x: u32) -> i32 {
+    1_i32 << x
+}
+
+pub const SECUREBITS_DEFAULT: i32 = 0x00000000;
+pub const SECURE_NOROOT: i32 = 0;
+pub const SECURE_NOROOT_LOCKED: i32 = 1;
+pub const SECBIT_NOROOT: i32 = issecure_mask(SECURE_NOROOT as u32);
+pub const SECBIT_NOROOT_LOCKED: i32 = issecure_mask(SECURE_NOROOT_LOCKED as u32);
+
+pub const SECURE_NO_SETUID_FIXUP: i32 = 2;
+pub const SECURE_NO_SETUID_FIXUP_LOCKED: i32 = 3;
+pub const SECBIT_NO_SETUID_FIXUP: i32 = issecure_mask(SECURE_NO_SETUID_FIXUP as u32);
+pub const SECBIT_NO_SETUID_FIXUP_LOCKED: i32 =
+    issecure_mask(SECURE_NO_SETUID_FIXUP_LOCKED as u32);
+
+pub const SECURE_KEEP_CAPS: i32 = 4;
+pub const SECURE_KEEP_CAPS_LOCKED: i32 = 5;
+pub const SECBIT_KEEP_CAPS: i32 = issecure_mask(SECURE_KEEP_CAPS as u32);
+pub const SECBIT_KEEP_CAPS_LOCKED: i32 = issecure_mask(SECURE_KEEP_CAPS_LOCKED as u32);
+
+pub const SECURE_NO_CAP_AMBIENT_RAISE: i32 = 6;
+pub const SECURE_NO_CAP_AMBIENT_RAISE_LOCKED: i32 = 7;
+pub const SECBIT_NO_CAP_AMBIENT_RAISE: i32 =
+    issecure_mask(SECURE_NO_CAP_AMBIENT_RAISE as u32);
+pub const SECBIT_NO_CAP_AMBIENT_RAISE_LOCKED: i32 =
+    issecure_mask(SECURE_NO_CAP_AMBIENT_RAISE_LOCKED as u32);
+
+pub const SECURE_EXEC_RESTRICT_FILE: i32 = 8;
+pub const SECURE_EXEC_RESTRICT_FILE_LOCKED: i32 = 9;
+pub const SECBIT_EXEC_RESTRICT_FILE: i32 = issecure_mask(SECURE_EXEC_RESTRICT_FILE as u32);
+pub const SECBIT_EXEC_RESTRICT_FILE_LOCKED: i32 =
+    issecure_mask(SECURE_EXEC_RESTRICT_FILE_LOCKED as u32);
+
+pub const SECURE_EXEC_DENY_INTERACTIVE: i32 = 10;
+pub const SECURE_EXEC_DENY_INTERACTIVE_LOCKED: i32 = 11;
+pub const SECBIT_EXEC_DENY_INTERACTIVE: i32 =
+    issecure_mask(SECURE_EXEC_DENY_INTERACTIVE as u32);
+pub const SECBIT_EXEC_DENY_INTERACTIVE_LOCKED: i32 =
+    issecure_mask(SECURE_EXEC_DENY_INTERACTIVE_LOCKED as u32);
+
+pub const SECURE_ALL_BITS: i32 = issecure_mask(SECURE_NOROOT as u32)
+    | issecure_mask(SECURE_NO_SETUID_FIXUP as u32)
+    | issecure_mask(SECURE_KEEP_CAPS as u32)
+    | issecure_mask(SECURE_NO_CAP_AMBIENT_RAISE as u32)
+    | issecure_mask(SECURE_EXEC_RESTRICT_FILE as u32)
+    | issecure_mask(SECURE_EXEC_DENY_INTERACTIVE as u32);
+pub const SECURE_ALL_LOCKS: i32 = SECURE_ALL_BITS << 1;
+pub const SECURE_ALL_UNPRIVILEGED: i32 =
+    issecure_mask(SECURE_EXEC_RESTRICT_FILE as u32)
+        | issecure_mask(SECURE_EXEC_DENY_INTERACTIVE as u32);
