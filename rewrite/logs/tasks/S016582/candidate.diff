+/// The state of either end of the Xenbus during bus initialization.
+///
+/// This is the Rust representation of Linux's C `enum xenbus_state`.  The
+/// explicit C representation preserves the integer enum ABI used by the
+/// Xen-facing kernel interfaces.
+#[repr(C)]
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum xenbus_state {
+    XenbusStateUnknown = 0,
+    XenbusStateInitialising = 1,
+    XenbusStateInitWait = 2,
+    XenbusStateInitialised = 3,
+    XenbusStateConnected = 4,
+    XenbusStateClosing = 5,
+    XenbusStateClosed = 6,
+    XenbusStateReconfiguring = 7,
+    XenbusStateReconfigured = 8,
+}
